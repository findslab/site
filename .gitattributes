# Normalize line endings: store as LF in the repository,
# and check out as LF on every platform (prevents CRLF diff noise on Windows).
* text=auto eol=lf

# Source and config
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.xml   text eol=lf
*.svg   text eol=lf
*.txt   text eol=lf
*.py    text eol=lf

# Shell scripts must keep LF to remain executable
*.sh    text eol=lf

# Binary assets: never touch line endings
*.webp  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.pdf   binary
*.docx  binary
*.xlsx  binary
*.pptx  binary
*.zip   binary
